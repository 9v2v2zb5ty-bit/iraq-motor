/* ============================================================
   RENDER ENGINE
   ============================================================ */
let currentLang = "ar";
let activeTab = MENU[0].id;

function fmt(n){ return n.toLocaleString('en-US'); }

function applyStaticText(){
  document.querySelectorAll('[data-ar]').forEach(el=>{
    const val = currentLang === 'ar' ? el.getAttribute('data-ar') : el.getAttribute('data-en');
    if(val !== null) el.innerHTML = val;
  });
}

function renderTicker(){
  const items = TICKER_ITEMS[currentLang];
  const doubled = items.concat(items).concat(items);
  document.getElementById('tickerTrack').innerHTML = doubled.map(t=>`<span>${t}</span>`).join('');
}

function renderPicks(){
  const el = document.getElementById('picksScroller');
  el.innerHTML = PICKS.map(p=>`
    <div class="pick-card">
      <div class="pick-photo">
        <img src="${p.img}" alt="${p.name[currentLang]}" loading="lazy">
        <span class="pick-tag">${p.tag[currentLang]}</span>
      </div>
      <div class="pick-body">
        <h3>${p.name[currentLang]}</h3>
        <p>${p.desc[currentLang]}</p>
        <div class="pick-price">
          <span class="price">${p.price}<span class="iqd">${currentLang==='ar'?'د.ع':'IQD'}</span></span>
        </div>
      </div>
    </div>
  `).join('');
}

function priceTableHTML(item){
  if(item.type === "simple"){
    return `<div class="simple-price"><span class="amount">${fmt(item.price)}</span><span style="font-size:12px;color:rgba(22,16,14,0.5);">${currentLang==='ar'?'د.ع':'IQD'}</span></div>`;
  }
  if(item.type === "list"){
    return `<div class="simple-price"><span class="amount">${fmt(item.price)}</span><span style="font-size:12px;color:rgba(22,16,14,0.5);">${currentLang==='ar'?'د.ع / للصوص':'IQD each'}</span></div>`;
  }
  // table
  const sizes = item.sizeLabels[currentLang];
  let head = `<tr><th></th>${sizes.map(s=>`<th>${s}</th>`).join('')}</tr>`;
  let body = item.rows.map(r=>`<tr><td class="rowlabel">${r[currentLang]}</td>${r.prices.map(p=>`<td>${fmt(p)}</td>`).join('')}</tr>`).join('');
  return `<table class="price-table">${head}${body}</table>`;
}

function renderMenuTabs(){
  const el = document.getElementById('menuTabs');
  el.innerHTML = MENU.map(cat=>`
    <button class="menu-tab ${cat.id===activeTab?'active':''}" data-cat="${cat.id}">${cat.tab[currentLang]}</button>
  `).join('');
  el.querySelectorAll('.menu-tab').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      activeTab = btn.getAttribute('data-cat');
      renderMenuTabs();
      renderMenuGrid();
    });
  });
}

function renderMenuGrid(){
  const cat = MENU.find(c=>c.id===activeTab);
  const el = document.getElementById('menuGrid');
  el.innerHTML = cat.items.map(item=>`
    <div class="menu-item">
      <div class="menu-item-top">
        <h4>${item[currentLang]}${item.spicy?'<span class="spicy-dot">🌶</span>':''}</h4>
      </div>
      ${item.descAr ? `<p class="desc">${currentLang==='ar'?item.descAr:item.descEn}</p>` : '<p class="desc">&nbsp;</p>'}
      ${priceTableHTML(item)}
    </div>
  `).join('');
}

function renderLocations(){
  const el = document.getElementById('locGrid');
  el.innerHTML = LOCATIONS.map(loc=>{
    const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(loc.mapQuery)}`;
    return `
    <div class="loc-card">
      <div class="halftone"></div>
      <div class="city-tag">99GRILL · IRAQ</div>
      <h3>${loc.city[currentLang]}</h3>
      <div class="addr">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-7.2-7-12a7 7 0 0 1 14 0c0 4.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
        <span>${currentLang==='ar'?loc.addrAr:loc.addrEn}</span>
      </div>
      <div class="loc-actions">
        <a class="btn btn-gold" href="${mapUrl}" target="_blank" rel="noopener">${currentLang==='ar'?'الموقع على الخريطة':'Get Directions'}</a>
        <a class="btn btn-ghost" style="border-color:rgba(255,255,255,0.35);color:#fff;" href="${waLink(currentLang)}" target="_blank" rel="noopener">${currentLang==='ar'?'واتساب':'WhatsApp'}</a>
      </div>
    </div>`;
  }).join('');
}

function renderReviews(){
  const el = document.getElementById('reviewsGrid');
  el.innerHTML = REVIEWS.map(r=>`
    <div class="review-card">
      <div class="review-stars">★★★★★</div>
      <p>${currentLang==='ar'?r.ar:r.en}</p>
      <div class="review-who">
        <div class="review-avatar">${r.initials}</div>
        <div class="meta">
          <span class="nm">${r.name[currentLang]}</span>
          <span class="city">${r.city[currentLang]}</span>
        </div>
      </div>
    </div>
  `).join('');
}

function updateWaButtons(){
  const link = waLink(currentLang);
  ['nav-order-btn','hero-wa-btn','cta-wa-btn','fab-wa-btn'].forEach(id=>{
    const elx = document.getElementById(id);
    if(elx) elx.setAttribute('href', link);
  });
}

function setLang(lang){
  currentLang = lang;
  document.body.setAttribute('lang-mode', lang);
  document.documentElement.setAttribute('lang', lang);
  document.documentElement.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
  document.getElementById('lang-ar').classList.toggle('active', lang==='ar');
  document.getElementById('lang-en').classList.toggle('active', lang==='en');
  applyStaticText();
  renderTicker();
  renderPicks();
  renderMenuTabs();
  renderMenuGrid();
  renderLocations();
  renderReviews();
  updateWaButtons();
}

function toggleDrawer(open){
  document.getElementById('mobileDrawer').classList.toggle('open', open);
}

function initReveal(){
  const items = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(en=>{
      if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); }
    });
  }, {threshold:0.12});
  items.forEach(it=>io.observe(it));
}

document.addEventListener('DOMContentLoaded', ()=>{
  setLang('ar');
  initReveal();
});

</script>
</body>
</html>
