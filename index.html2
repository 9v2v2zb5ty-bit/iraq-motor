<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>99GRILL IRAQ | برجر و وينجز</title>
<meta name="description" content="99GRILL Iraq — برجر ووينجز. فروعنا في كركوك، تكريت، كربلاء والموصل. اطلب توصيل عبر واتساب.">
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#16100E;
  --ink-soft:#231916;
  --paper:#F6EFE2;
  --paper-dim:#ECE2CE;
  --red:#D81C25;
  --red-deep:#7A0D14;
  --red-darker:#4A0810;
  --gold:#D9A441;
  --gold-soft:#E8C988;
  --white:#FFFFFF;
  --line:rgba(246,239,226,0.14);
  --line-dark:rgba(22,16,14,0.12);
  --shadow:0 18px 40px rgba(0,0,0,0.35);
  --radius:18px;
  --maxw:1180px;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto;} *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}}
body{
  margin:0;
  background:var(--ink);
  color:var(--paper);
  font-family:'Cairo',sans-serif;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px;}
.en-face{font-family:'Anton',sans-serif;font-weight:400;letter-spacing:0.5px;}
[lang-mode="ar"] .only-en{display:none !important;}
[lang-mode="en"] .only-ar{display:none !important;}

/* ===== halftone + texture helpers ===== */
.halftone{
  position:absolute;inset:0;
  background-image:radial-gradient(rgba(255,255,255,0.16) 1.4px, transparent 1.4px);
  background-size:13px 13px;
  opacity:0.35;
  pointer-events:none;
  mix-blend-mode:overlay;
}
.grain{
  position:absolute;inset:0;
  background-image:radial-gradient(rgba(0,0,0,0.5) 1px, transparent 1px);
  background-size:3px 3px;
  opacity:0.06;
  pointer-events:none;
}

/* ===== story-card chrome (signature element) ===== */
.story-chrome{position:relative;}
.story-chrome::before{
  content:"";
  position:absolute;top:0;left:18px;right:18px;height:4px;
  background:repeating-linear-gradient(90deg, rgba(255,255,255,0.85) 0 28px, transparent 28px 34px);
  border-radius:4px;
  opacity:0.55;
}
.story-pin{
  position:absolute;top:22px;
  inset-inline-end:24px;
  width:34px;height:34px;
  display:grid;place-items:center;
  background:rgba(255,255,255,0.12);
  border-radius:50%;
  transform:rotate(18deg);
}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-size:13px;letter-spacing:2.5px;text-transform:uppercase;
  color:var(--gold-soft);font-weight:700;
}
.eyebrow::before{content:"";width:18px;height:2px;background:var(--gold-soft);}

/* ===================== NAV ===================== */
header.site-nav{
  position:sticky;top:0;z-index:100;
  background:rgba(22,16,14,0.86);
  backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line);
}
.nav-inner{
  max-width:var(--maxw);margin:0 auto;padding:12px 22px;
  display:flex;align-items:center;justify-content:space-between;gap:14px;
}
.brand{display:flex;align-items:center;gap:10px;}
.brand img{width:42px;height:42px;border-radius:50%;}
.brand-name{font-family:'Anton',sans-serif;font-size:20px;letter-spacing:1px;color:var(--white);}
.brand-name span{color:var(--red);}
nav.links{display:flex;gap:26px;align-items:center;}
nav.links a{font-size:14.5px;font-weight:600;color:rgba(246,239,226,0.82);position:relative;padding:4px 0;}
nav.links a:hover{color:var(--white);}
.nav-actions{display:flex;align-items:center;gap:10px;}
.lang-toggle{
  display:flex;background:rgba(246,239,226,0.08);border:1px solid var(--line);border-radius:999px;padding:3px;gap:2px;
}
.lang-toggle button{
  border:none;background:transparent;color:rgba(246,239,226,0.7);
  font-weight:700;font-size:12.5px;padding:6px 12px;border-radius:999px;transition:all .25s;
}
.lang-toggle button.active{background:var(--red);color:#fff;}
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:10px 18px;border-radius:999px;font-weight:700;font-size:14px;
  border:1px solid transparent;transition:transform .2s ease, box-shadow .2s ease;
  white-space:nowrap;
}
.btn:hover{transform:translateY(-2px);}
.btn-red{background:var(--red);color:#fff;box-shadow:0 10px 22px rgba(216,28,37,0.35);}
.btn-ghost{background:transparent;border-color:var(--line);color:var(--paper);}
.btn-gold{background:var(--gold);color:#241405;}
.btn svg{width:17px;height:17px;flex:none;}
.burger-toggle{display:none;background:none;border:none;color:var(--white);}
.burger-toggle svg{width:26px;height:26px;}

/* ===================== HERO ===================== */
.hero{
  position:relative;min-height:92vh;display:flex;align-items:flex-end;
  background:#0c0908;
}
.hero-media{position:absolute;inset:0;overflow:hidden;}
.hero-media img{width:100%;height:100%;object-fit:cover;object-position:center 22%;filter:saturate(1.08) contrast(1.04);}
.hero-media::after{
  content:"";position:absolute;inset:0;
  background:
    linear-gradient(180deg, rgba(12,9,8,0.15) 0%, rgba(12,9,8,0.55) 55%, rgba(12,9,8,0.96) 100%),
    linear-gradient(90deg, rgba(12,9,8,0.75) 0%, rgba(12,9,8,0.1) 45%);
}
.hero-content{position:relative;z-index:2;width:100%;padding:0 22px 64px;max-width:var(--maxw);margin:0 auto;}
.hero-eyebrow{margin-bottom:18px;}
.hero h1{
  font-family:'Anton',sans-serif;
  font-size:clamp(46px,8.4vw,108px);
  line-height:0.92;margin:0 0 18px;color:var(--white);
  text-transform:uppercase;letter-spacing:1px;
  text-shadow:0 8px 30px rgba(0,0,0,0.4);
}
[lang-mode="ar"] .hero h1{font-family:'Cairo',sans-serif;font-weight:900;letter-spacing:0;font-size:clamp(38px,7vw,84px);}
.hero h1 em{font-style:normal;color:var(--red);-webkit-text-stroke:0;}
.hero p.lede{font-size:clamp(16px,2vw,20px);max-width:560px;color:rgba(246,239,226,0.88);margin:0 0 30px;line-height:1.7;}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:38px;}
.hero-meta{display:flex;gap:28px;flex-wrap:wrap;padding-top:24px;border-top:1px solid var(--line);}
.hero-meta div{display:flex;flex-direction:column;gap:4px;}
.hero-meta .num{font-family:'Anton',sans-serif;font-size:28px;color:var(--gold-soft);}
[lang-mode="ar"] .hero-meta .num{font-family:'Cairo',sans-serif;font-weight:800;}
.hero-meta .lbl{font-size:12.5px;color:rgba(246,239,226,0.65);letter-spacing:1px;}

/* ===================== TICKER ===================== */
.ticker-band{
  background:var(--red);color:#fff;overflow:hidden;
  border-block:3px solid var(--ink);
  position:relative;
}
.ticker-track{display:flex;white-space:nowrap;width:max-content;animation:scroll-x 32s linear infinite;}
[dir="rtl"] .ticker-track{animation-name:scroll-x-rtl;}
.ticker-track span{
  font-family:'Anton',sans-serif;font-size:18px;letter-spacing:2px;
  padding:14px 26px;display:inline-flex;align-items:center;gap:14px;text-transform:uppercase;
}
[lang-mode="ar"] .ticker-track span{font-family:'Cairo',sans-serif;font-weight:800;letter-spacing:0;}
.ticker-track span::after{content:"●";font-size:9px;opacity:0.7;margin-inline-start:14px;color:rgba(255,255,255,0.8);}
@keyframes scroll-x{from{transform:translateX(0);}to{transform:translateX(-50%);}}
@keyframes scroll-x-rtl{from{transform:translateX(0);}to{transform:translateX(50%);}}

/* ===================== SECTION HEADERS ===================== */
.section{padding:88px 0;}
.section.dim{background:var(--ink-soft);}
.section-head{max-width:640px;margin:0 0 48px;}
.section-head h2{
  font-family:'Anton',sans-serif;font-size:clamp(32px,5vw,52px);margin:10px 0 14px;
  color:var(--white);text-transform:uppercase;line-height:1;
}
[lang-mode="ar"] .section-head h2{font-family:'Cairo',sans-serif;font-weight:900;}
.section-head p{color:rgba(246,239,226,0.72);font-size:16px;line-height:1.7;margin:0;}
.section-head.on-paper h2{color:var(--ink);}
.section-head.on-paper p{color:rgba(22,16,14,0.68);}
.section-head.on-paper .eyebrow{color:var(--red);}
.section-head.on-paper .eyebrow::before{background:var(--red);}

/* ===================== SIGNATURE PICKS ===================== */
.picks-scroller{
  display:grid;grid-auto-flow:column;grid-auto-columns:min(78vw,300px);
  gap:18px;overflow-x:auto;padding:6px 0 18px;scroll-snap-type:x mandatory;
  -ms-overflow-style:none;scrollbar-width:none;
}
.picks-scroller::-webkit-scrollbar{display:none;}
.pick-card{
  scroll-snap-align:start;background:var(--paper);border-radius:var(--radius);
  overflow:hidden;box-shadow:var(--shadow);display:flex;flex-direction:column;
  transition:transform .35s ease;
}
.pick-card:hover{transform:translateY(-6px);}
.pick-photo{aspect-ratio:1/1;overflow:hidden;background:#fff;position:relative;}
.pick-photo img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease;}
.pick-card:hover .pick-photo img{transform:scale(1.06);}
.pick-tag{
  position:absolute;top:12px;inset-inline-start:12px;background:var(--red);color:#fff;
  font-size:11.5px;font-weight:800;padding:5px 11px;border-radius:999px;letter-spacing:0.5px;
}
.pick-body{padding:18px 18px 20px;color:var(--ink);}
.pick-body h3{font-size:19px;margin:0 0 6px;font-weight:800;}
.pick-body p{font-size:13.5px;color:rgba(22,16,14,0.62);margin:0 0 14px;line-height:1.6;min-height:42px;}
.pick-price{display:flex;align-items:center;justify-content:space-between;}
.pick-price .price{font-family:'Anton',sans-serif;color:var(--red);font-size:20px;}
[lang-mode="ar"] .pick-price .price{font-family:'Cairo',sans-serif;font-weight:900;}
.pick-price .iqd{font-size:11px;color:rgba(22,16,14,0.5);margin-inline-start:4px;}

/* ===================== MENU ===================== */
.menu-tabs{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:36px;}
.menu-tab{
  padding:11px 20px;border-radius:999px;border:1.5px solid rgba(22,16,14,0.16);
  background:transparent;color:rgba(22,16,14,0.68);font-weight:700;font-size:14px;transition:all .2s;
}
.menu-tab.active{background:var(--ink);border-color:var(--ink);color:var(--white);}
.menu-tab:hover:not(.active){border-color:var(--red);color:var(--red);}

.menu-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}
.menu-item{
  background:var(--paper);border-radius:14px;padding:20px;color:var(--ink);
  border:1px solid rgba(22,16,14,0.08);
}
.menu-item-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:8px;}
.menu-item h4{font-size:17px;margin:0;font-weight:800;display:flex;align-items:center;gap:7px;}
.spicy-dot{color:var(--red);font-size:13px;}
.menu-item p.desc{font-size:13.5px;line-height:1.65;color:rgba(22,16,14,0.6);margin:0 0 14px;}
.price-table{width:100%;border-collapse:collapse;font-size:13px;}
.price-table th{
  font-weight:700;color:rgba(22,16,14,0.55);text-align:center;padding:6px 4px;
  border-bottom:1px solid rgba(22,16,14,0.12);font-size:11.5px;text-transform:uppercase;letter-spacing:0.3px;
}
.price-table td{text-align:center;padding:7px 4px;font-weight:800;color:var(--red-deep);}
.price-table td.rowlabel{text-align:start;font-weight:700;color:var(--ink);font-size:12.5px;}
.price-table tr+tr td{border-top:1px solid rgba(22,16,14,0.06);}
.simple-price{display:flex;align-items:baseline;gap:6px;}
.simple-price .amount{font-family:'Anton',sans-serif;font-size:22px;color:var(--red-deep);}
[lang-mode="ar"] .simple-price .amount{font-family:'Cairo',sans-serif;font-weight:900;}
.simple-list{display:flex;flex-direction:column;gap:10px;}
.simple-list .row{display:flex;justify-content:space-between;align-items:center;padding-bottom:9px;border-bottom:1px dashed rgba(22,16,14,0.14);}
.simple-list .row:last-child{border-bottom:none;padding-bottom:0;}
.simple-list .row .nm{font-weight:700;font-size:14.5px;}
.simple-list .row .pr{font-weight:800;color:var(--red-deep);font-size:14.5px;white-space:nowrap;}
.note-box{
  margin-top:18px;background:rgba(216,28,37,0.06);border:1px dashed rgba(216,28,37,0.3);
  border-radius:12px;padding:14px 16px;font-size:13px;color:rgba(22,16,14,0.7);line-height:1.7;
}
.note-box b{color:var(--red-deep);}

/* ===================== LOCATIONS ===================== */
.loc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;}
.loc-card{
  position:relative;background:linear-gradient(160deg,var(--red) 0%, var(--red-deep) 100%);
  border-radius:var(--radius);padding:30px 26px 26px;overflow:hidden;
  box-shadow:var(--shadow);min-height:280px;display:flex;flex-direction:column;
}
.loc-card .city-tag{
  font-family:'Anton',sans-serif;font-size:13px;letter-spacing:2px;color:var(--gold-soft);
  text-transform:uppercase;margin-bottom:6px;
}
[lang-mode="ar"] .loc-card .city-tag{font-family:'Cairo',sans-serif;font-weight:700;letter-spacing:1px;}
.loc-card h3{font-family:'Anton',sans-serif;font-size:34px;color:#fff;margin:0 0 16px;text-transform:uppercase;}
[lang-mode="ar"] .loc-card h3{font-family:'Cairo',sans-serif;font-weight:900;}
.loc-card .addr{
  display:flex;gap:10px;align-items:flex-start;color:rgba(255,255,255,0.92);
  font-size:14.5px;line-height:1.7;margin-bottom:auto;padding-bottom:20px;
}
.loc-card .addr svg{width:19px;height:19px;flex:none;margin-top:2px;color:var(--gold-soft);}
.loc-actions{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap;}
.loc-actions .btn{padding:9px 16px;font-size:13px;}
.loc-card .pin-deco{position:absolute;bottom:-18px;inset-inline-end:-14px;opacity:0.14;width:140px;height:140px;}

/* ===================== REVIEWS ===================== */
.reviews-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.review-card{
  background:var(--paper);border-radius:14px;padding:24px;color:var(--ink);
  display:flex;flex-direction:column;gap:14px;
}
.review-stars{color:var(--gold);font-size:14px;letter-spacing:2px;}
.review-card p{font-size:14.5px;line-height:1.75;margin:0;color:rgba(22,16,14,0.78);flex:1;}
.review-who{display:flex;align-items:center;gap:10px;padding-top:10px;border-top:1px solid rgba(22,16,14,0.1);}
.review-avatar{
  width:36px;height:36px;border-radius:50%;background:var(--red);color:#fff;
  display:grid;place-items:center;font-weight:800;font-size:14px;flex:none;
}
.review-who .meta{display:flex;flex-direction:column;}
.review-who .nm{font-weight:800;font-size:13.5px;}
.review-who .city{font-size:11.5px;color:rgba(22,16,14,0.5);}
.reviews-note{margin-top:24px;font-size:12.5px;color:rgba(246,239,226,0.45);text-align:center;}

/* ===================== CTA STRIP ===================== */
.cta-strip{
  position:relative;background:var(--ink);overflow:hidden;padding:70px 0;text-align:center;
}
.cta-strip h2{
  font-family:'Anton',sans-serif;font-size:clamp(30px,5.4vw,58px);color:var(--white);margin:0 0 16px;text-transform:uppercase;
}
[lang-mode="ar"] .cta-strip h2{font-family:'Cairo',sans-serif;font-weight:900;}
.cta-strip p{color:rgba(246,239,226,0.7);font-size:16px;margin:0 0 30px;}
.cta-strip .btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}

/* ===================== FOOTER ===================== */
footer{background:var(--ink-soft);border-top:1px solid var(--line);padding:60px 0 26px;}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:36px;margin-bottom:46px;}
.foot-brand .brand{margin-bottom:14px;}
.foot-brand p{font-size:13.5px;color:rgba(246,239,226,0.6);line-height:1.8;max-width:280px;}
.foot-col h5{font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold-soft);margin:0 0 16px;}
.foot-col a, .foot-col .phone{display:block;font-size:14px;color:rgba(246,239,226,0.78);margin-bottom:11px;}
.foot-col a:hover{color:var(--white);}
.foot-social{display:flex;gap:10px;margin-top:6px;}
.foot-social a{
  width:38px;height:38px;border-radius:50%;border:1px solid var(--line);
  display:grid;place-items:center;
}
.foot-social a:hover{background:var(--red);border-color:var(--red);}
.foot-social svg{width:17px;height:17px;}
.foot-bottom{
  border-top:1px solid var(--line);padding-top:22px;display:flex;justify-content:space-between;
  flex-wrap:wrap;gap:10px;font-size:12.5px;color:rgba(246,239,226,0.45);
}

/* ===================== WHATSAPP FAB ===================== */
.wa-fab{
  position:fixed;bottom:22px;inset-inline-end:22px;z-index:200;
  width:60px;height:60px;border-radius:50%;background:#25D366;
  display:grid;place-items:center;box-shadow:0 12px 28px rgba(0,0,0,0.4);
  animation:pulse-wa 2.6s ease-in-out infinite;
}
.wa-fab svg{width:30px;height:30px;color:#fff;}
@keyframes pulse-wa{0%,100%{box-shadow:0 12px 28px rgba(0,0,0,0.4), 0 0 0 0 rgba(37,211,102,0.5);}50%{box-shadow:0 12px 28px rgba(0,0,0,0.4), 0 0 0 12px rgba(37,211,102,0);}}

/* ===================== reveal anim ===================== */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease, transform .7s ease;}
.reveal.in{opacity:1;transform:translateY(0);}

/* ===================== RESPONSIVE ===================== */
@media (max-width:980px){
  .foot-grid{grid-template-columns:1fr 1fr;}
  .reviews-grid{grid-template-columns:repeat(2,1fr);}
}
@media (max-width:860px){
  nav.links{display:none;}
  .burger-toggle{display:block;}
  .hero{min-height:88vh;}
  .loc-grid{grid-template-columns:1fr;}
}
@media (max-width:640px){
  .menu-grid{grid-template-columns:1fr;}
  .reviews-grid{grid-template-columns:1fr;}
  .foot-grid{grid-template-columns:1fr 1fr;gap:28px;}
  .section{padding:60px 0;}
  .hero-meta{gap:20px;}
  .nav-actions .btn-red span.lbl-text{display:none;}
}

/* mobile menu drawer */
.mobile-drawer{
  position:fixed;inset:0;background:rgba(12,9,8,0.98);z-index:300;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;
  opacity:0;pointer-events:none;transition:opacity .3s ease;
}
.mobile-drawer.open{opacity:1;pointer-events:all;}
.mobile-drawer a{font-size:24px;font-weight:800;color:#fff;}
.mobile-drawer .close-drawer{position:absolute;top:24px;inset-inline-end:24px;background:none;border:none;color:#fff;}
.mobile-drawer .close-drawer svg{width:28px;height:28px;}
</style>
</head>
<body lang-mode="ar">

<!-- ============ NAV ============ -->
<header class="site-nav">
  <div class="nav-inner">
    <a href="#top" class="brand">
      <img src="data:image/png;base64," alt="99GRILL logo">
      <span class="brand-name">99<span>GRILL</span></span>
    </a>
    <nav class="links">
      <a href="#menu" data-ar="المنيو" data-en="Menu">المنيو</a>
      <a href="#picks" data-ar="الأشهر" data-en="Signature">الأشهر</a>
      <a href="#locations" data-ar="الفروع" data-en="Locations">الفروع</a>
      <a href="#reviews" data-ar="آراء الزبائن" data-en="Reviews">آراء الزبائن</a>
    </nav>
    <div class="nav-actions">
      <div class="lang-toggle" role="group" aria-label="Language">
        <button id="lang-ar" class="active" onclick="setLang('ar')">عربي</button>
        <button id="lang-en" onclick="setLang('en')">EN</button>
      </div>
      <a class="btn btn-red" id="nav-order-btn" target="_blank" rel="noopener">
