<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>99GRILL IRAQ | برجر و وينجز</title>
<link rel="icon" href="data:image/png;base64,">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#16100E;--ink2:#231916;--paper:#F6EFE2;--paper2:#ECE2CE;
  --red:#D81C25;--red2:#7A0D14;--gold:#D9A441;--gold2:#E8C988;
  --white:#fff;--line:rgba(246,239,226,0.13);--line2:rgba(22,16,14,0.1);
  --r:18px;--max:1160px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--ink);color:var(--paper);font-family:Cairo,sans-serif;-webkit-font-smoothing:antialiased;padding-bottom:64px;}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;}
.wrap{max-width:var(--max);margin:0 auto;padding:0 20px;}

/* ── NAV ── */
.nav{position:sticky;top:0;z-index:200;background:rgba(22,16,14,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);}
.nav-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:var(--max);margin:0 auto;padding:10px 20px;}
.brand{display:flex;align-items:center;gap:9px;cursor:pointer;}
.brand img{width:38px;height:38px;border-radius:50%;}
.brand-name{font-family:Anton,sans-serif;font-size:19px;letter-spacing:1px;}
.brand-name span{color:var(--red);}
.desktop-links{display:flex;gap:24px;}
.desktop-links button{background:none;border:none;color:rgba(246,239,226,.75);font-size:14px;font-weight:700;padding:4px 0;font-family:Cairo,sans-serif;}
.desktop-links button:hover,.desktop-links button.act{color:#fff;}
.nav-right{display:flex;align-items:center;gap:10px;}
.lang-pill{display:flex;background:rgba(246,239,226,.08);border:1px solid var(--line);border-radius:999px;padding:3px;}
.lang-pill button{border:none;background:transparent;color:rgba(246,239,226,.65);font-weight:700;font-size:12px;padding:5px 11px;border-radius:999px;transition:all .2s;font-family:Cairo,sans-serif;}
.lang-pill button.act{background:var(--red);color:#fff;}
.btn-wa{display:flex;align-items:center;gap:7px;background:var(--red);color:#fff;padding:9px 16px;border-radius:999px;font-weight:700;font-size:13px;border:none;white-space:nowrap;}
.btn-wa svg{width:16px;height:16px;flex:none;}
.hmenu-btn{display:none;background:none;border:none;color:#fff;}
.hmenu-btn svg{width:24px;height:24px;}

/* ── BOTTOM NAV ── */
.bnav{position:fixed;bottom:0;left:0;right:0;z-index:190;background:var(--ink2);border-top:1px solid var(--line);display:flex;padding-bottom:env(safe-area-inset-bottom,0px);}
.bnav-btn{flex:1;background:none;border:none;color:rgba(246,239,226,.5);font-size:10px;font-weight:700;font-family:Cairo,sans-serif;padding:9px 4px 6px;display:flex;flex-direction:column;align-items:center;gap:3px;}
.bnav-btn svg{width:20px;height:20px;}
.bnav-btn.act{color:var(--red);}

/* ── PAGES ── */
.page{display:none;}
.page.act{display:block;animation:pgIn .3s ease;}
@keyframes pgIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* ── HOME: HERO ── */
.hero{position:relative;min-height:92vh;display:flex;align-items:flex-end;overflow:hidden;}
.hero-bg{position:absolute;inset:0;}
.hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center 25%;}
.hero-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,9,8,.1) 0%,rgba(12,9,8,.6) 55%,rgba(12,9,8,.97) 100%),linear-gradient(90deg,rgba(12,9,8,.7),rgba(12,9,8,.05) 50%);}
.hero-body{position:relative;z-index:2;padding:0 20px 56px;max-width:var(--max);margin:0 auto;width:100%;}
.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold2);font-weight:700;margin-bottom:14px;}
.eyebrow::before{content:"";width:16px;height:2px;background:var(--gold2);}
.hero h1{font-family:Anton,sans-serif;font-size:clamp(44px,8vw,108px);line-height:.92;color:#fff;text-transform:uppercase;margin-bottom:16px;}
[lang-mode=ar] .hero h1{font-family:Cairo,sans-serif;font-weight:900;font-size:clamp(36px,7vw,84px);}
.hero h1 em{font-style:normal;color:var(--red);}
.hero-sub{font-size:clamp(15px,2vw,19px);max-width:520px;color:rgba(246,239,226,.85);margin-bottom:28px;line-height:1.75;}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:36px;}
.btn-gold{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:#241405;padding:12px 22px;border-radius:999px;font-weight:800;font-size:14.5px;border:none;}
.btn-outline{display:inline-flex;align-items:center;gap:8px;border:1.5px solid rgba(246,239,226,.35);color:var(--paper);padding:12px 20px;border-radius:999px;font-weight:700;font-size:14px;background:transparent;}
.hero-stats{display:flex;gap:24px;flex-wrap:wrap;padding-top:22px;border-top:1px solid var(--line);}
.hero-stat .num{font-family:Anton,sans-serif;font-size:28px;color:var(--gold2);}
[lang-mode=ar] .hero-stat .num{font-family:Cairo,sans-serif;font-weight:900;}
.hero-stat .lbl{font-size:12px;color:rgba(246,239,226,.6);letter-spacing:.5px;}

/* ── TICKER ── */
.ticker{background:var(--red);overflow:hidden;border-block:3px solid var(--ink);}
.ticker-track{display:flex;white-space:nowrap;width:max-content;animation:tick 30s linear infinite;}
[dir=ltr] .ticker-track{animation-name:tick-ltr;}
.ticker-track span{font-family:Anton,sans-serif;font-size:17px;letter-spacing:2px;padding:12px 22px;display:inline-flex;align-items:center;gap:12px;text-transform:uppercase;}
[lang-mode=ar] .ticker-track span{font-family:Cairo,sans-serif;font-weight:800;letter-spacing:0;}
.ticker-track span::after{content:"●";font-size:8px;opacity:.6;margin-inline-start:12px;}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes tick-ltr{from{transform:translateX(0)}to{transform:translateX(50%)}}

/* ── HOME: PICKS ── */
.section{padding:72px 0;}
.section-light{background:var(--paper);}
.sh{margin-bottom:36px;}
.sh-eye{display:inline-flex;align-items:center;gap:7px;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--gold2);font-weight:700;}
.sh-eye::before{content:"";width:14px;height:2px;background:var(--gold2);}
.section-light .sh-eye{color:var(--red);}
.section-light .sh-eye::before{background:var(--red);}
.sh h2{font-family:Anton,sans-serif;font-size:clamp(28px,5vw,50px);margin:8px 0 10px;color:#fff;text-transform:uppercase;line-height:1;}
[lang-mode=ar] .sh h2{font-family:Cairo,sans-serif;font-weight:900;}
.section-light .sh h2{color:var(--ink);}
.sh p{font-size:15px;color:rgba(246,239,226,.68);line-height:1.7;}
.section-light .sh p{color:rgba(22,16,14,.62);}

.picks-scroll{display:grid;grid-auto-flow:column;grid-auto-columns:min(76vw,290px);gap:16px;overflow-x:auto;padding:4px 0 16px;scroll-snap-type:x mandatory;-ms-overflow-style:none;scrollbar-width:none;}
.picks-scroll::-webkit-scrollbar{display:none;}
.pick{scroll-snap-align:start;background:var(--paper);border-radius:var(--r);overflow:hidden;box-shadow:0 14px 36px rgba(0,0,0,.32);transition:transform .3s;}
.pick:hover{transform:translateY(-5px);}
.pick-img{aspect-ratio:1;overflow:hidden;background:#fff;}
.pick-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s;}
.pick:hover .pick-img img{transform:scale(1.07);}
.pick-tag{position:absolute;top:10px;inset-inline-start:10px;background:var(--red);color:#fff;font-size:11px;font-weight:800;padding:4px 10px;border-radius:999px;}
.pick-body{padding:16px;color:var(--ink);}
.pick-body h3{font-size:17px;font-weight:800;margin-bottom:5px;}
.pick-body p{font-size:13px;color:rgba(22,16,14,.6);margin-bottom:12px;line-height:1.6;min-height:40px;}
.pick-price{font-family:Anton,sans-serif;font-size:20px;color:var(--red2);}
[lang-mode=ar] .pick-price{font-family:Cairo,sans-serif;font-weight:900;}
.pick-iqd{font-size:11px;color:rgba(22,16,14,.45);margin-inline-start:3px;}

/* ── HOME: CTA ── */
.cta{position:relative;padding:64px 0;text-align:center;overflow:hidden;background:radial-gradient(ellipse at center,rgba(216,28,37,.18) 0%,transparent 70%);}
.cta h2{font-family:Anton,sans-serif;font-size:clamp(28px,5vw,56px);color:#fff;margin-bottom:14px;text-transform:uppercase;}
[lang-mode=ar] .cta h2{font-family:Cairo,sans-serif;font-weight:900;}
.cta p{color:rgba(246,239,226,.7);font-size:16px;margin-bottom:26px;}
.cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}

/* ── MENU PAGE ── */
.menu-page{padding:28px 0 40px;}
.cat-bar{position:sticky;top:60px;z-index:100;background:var(--ink);padding:12px 0;border-bottom:1px solid var(--line);}
.cat-scroll{display:flex;gap:8px;overflow-x:auto;padding:0 20px;-ms-overflow-style:none;scrollbar-width:none;}
.cat-scroll::-webkit-scrollbar{display:none;}
.cat-btn{flex:none;padding:9px 18px;border-radius:999px;border:1.5px solid rgba(246,239,226,.18);background:transparent;color:rgba(246,239,226,.7);font-weight:700;font-size:13.5px;font-family:Cairo,sans-serif;white-space:nowrap;transition:all .2s;}
.cat-btn.act,.cat-btn:hover{border-color:var(--red);background:var(--red);color:#fff;}

.items-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:24px 20px 0;max-width:var(--max);margin:0 auto;}
.item-card{background:var(--paper);border-radius:16px;overflow:hidden;cursor:pointer;box-shadow:0 4px 20px rgba(0,0,0,.18);transition:transform .25s,box-shadow .25s;}
.item-card:hover{transform:translateY(-4px);box-shadow:0 12px 30px rgba(0,0,0,.28);}
.item-card:active{transform:scale(.97);}
.ic-photo{aspect-ratio:1;overflow:hidden;position:relative;background:var(--red2);}
.ic-photo img{width:100%;height:100%;object-fit:cover;}
.ic-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:42px;background:linear-gradient(135deg,var(--red2),var(--red));}
.ic-spicy{position:absolute;top:8px;inset-inline-end:8px;font-size:14px;}
.ic-body{padding:13px;}
.ic-name{font-size:15px;font-weight:800;color:var(--ink);margin-bottom:3px;}
.ic-desc{font-size:11.5px;color:rgba(22,16,14,.58);line-height:1.5;margin-bottom:9px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:32px;}
.ic-footer{display:flex;align-items:center;justify-content:space-between;}
.ic-from{font-size:10px;color:rgba(22,16,14,.45);}
.ic-price{font-family:Anton,sans-serif;font-size:17px;color:var(--red2);}
[lang-mode=ar] .ic-price{font-family:Cairo,sans-serif;font-weight:900;}
.ic-arrow{width:28px;height:28px;border-radius:50%;background:var(--ink);display:flex;align-items:center;justify-content:center;flex:none;}
.ic-arrow svg{width:13px;height:13px;color:#fff;}

/* ── MODAL ── */
.modal-wrap{position:fixed;inset:0;z-index:700;background:rgba(0,0,0,.7);display:none;align-items:flex-end;backdrop-filter:blur(4px);}
.modal-wrap.open{display:flex;}
.modal-sheet{background:var(--paper);border-radius:26px 26px 0 0;width:100%;max-height:90vh;overflow-y:auto;position:relative;animation:sup .35s cubic-bezier(.34,1.1,.64,1);}
@keyframes sup{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-close{position:sticky;top:0;float:right;z-index:2;margin:14px 14px 0 0;background:rgba(22,16,14,.12);border:none;border-radius:50%;width:32px;height:32px;font-size:16px;display:flex;align-items:center;justify-content:center;color:var(--ink);cursor:pointer;}
.modal-photo{width:100%;aspect-ratio:4/3;overflow:hidden;}
.modal-photo img{width:100%;height:100%;object-fit:cover;}
.modal-ph{width:100%;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-size:80px;background:linear-gradient(135deg,var(--red2),var(--red));}
.modal-body{padding:20px 22px 36px;color:var(--ink);}
.modal-ar{font-size:24px;font-weight:900;margin-bottom:3px;}
.modal-en{font-size:13px;color:rgba(22,16,14,.5);font-weight:600;margin-bottom:14px;}
.modal-desc{font-size:14px;line-height:1.8;color:rgba(22,16,14,.7);margin-bottom:20px;}
.modal-ptable{width:100%;border-collapse:collapse;font-size:13px;margin-bottom:22px;}
.modal-ptable th{font-weight:700;color:rgba(22,16,14,.5);padding:7px 6px;border-bottom:2px solid var(--line2);font-size:11px;text-transform:uppercase;letter-spacing:.3px;}
.modal-ptable td{text-align:center;padding:8px 6px;font-weight:800;color:var(--red2);}
.modal-ptable .rl{text-align:start;color:var(--ink);font-weight:600;font-size:13px;}
.modal-ptable tr:not(:last-child) td{border-bottom:1px solid var(--line2);}
.simple-amt{font-family:Anton,sans-serif;font-size:26px;color:var(--red2);margin-bottom:20px;}
[lang-mode=ar] .simple-amt{font-family:Cairo,sans-serif;font-weight:900;}
.btn-order-modal{width:100%;background:#25D366;color:#fff;border:none;padding:15px;border-radius:14px;font-size:16px;font-weight:800;font-family:Cairo,sans-serif;display:flex;align-items:center;justify-content:center;gap:10px;}
.btn-order-modal svg{width:20px;height:20px;}

/* ── LOCATIONS PAGE ── */
.loc-page{padding:40px 20px;max-width:var(--max);margin:0 auto;}
.loc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:32px;}
.loc-card{background:linear-gradient(145deg,var(--red),var(--red2));border-radius:var(--r);padding:28px 24px 24px;overflow:hidden;position:relative;box-shadow:0 16px 38px rgba(0,0,0,.35);}
.loc-card .city-tag{font-size:11px;letter-spacing:2px;color:var(--gold2);font-weight:700;text-transform:uppercase;margin-bottom:4px;}
.loc-card h3{font-family:Anton,sans-serif;font-size:32px;color:#fff;margin-bottom:14px;text-transform:uppercase;}
[lang-mode=ar] .loc-card h3{font-family:Cairo,sans-serif;font-weight:900;}
.loc-addr{display:flex;gap:8px;align-items:flex-start;color:rgba(255,255,255,.9);font-size:14px;line-height:1.7;margin-bottom:20px;}
.loc-addr svg{width:18px;height:18px;flex:none;margin-top:2px;color:var(--gold2);}
.loc-btns{display:flex;gap:8px;flex-wrap:wrap;}
.btn-map{background:var(--gold);color:#241405;padding:9px 16px;border-radius:999px;font-weight:800;font-size:12.5px;border:none;font-family:Cairo,sans-serif;}
.btn-wa-loc{background:transparent;border:1.5px solid rgba(255,255,255,.4);color:#fff;padding:8px 14px;border-radius:999px;font-weight:700;font-size:12.5px;font-family:Cairo,sans-serif;}

/* ── REVIEWS PAGE ── */
.rev-page{padding:40px 20px;max-width:var(--max);margin:0 auto;}
.rev-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:32px;}
.rev-card{background:var(--paper);border-radius:14px;padding:22px;color:var(--ink);display:flex;flex-direction:column;gap:12px;}
.rev-stars{color:var(--gold);font-size:13px;letter-spacing:2px;}
.rev-text{font-size:14px;line-height:1.8;flex:1;color:rgba(22,16,14,.78);}
.rev-who{display:flex;align-items:center;gap:10px;border-top:1px solid var(--line2);padding-top:10px;}
.rev-av{width:34px;height:34px;border-radius:50%;background:var(--red);color:#fff;display:grid;place-items:center;font-weight:800;font-size:14px;flex:none;}
.rev-nm{font-weight:800;font-size:13px;}
.rev-city{font-size:11px;color:rgba(22,16,14,.45);}
.rev-note{text-align:center;font-size:12px;color:rgba(246,239,226,.4);margin-top:20px;}

/* ── WA FAB ── */
.wa-fab{position:fixed;bottom:74px;inset-inline-end:20px;z-index:300;width:54px;height:54px;border-radius:50%;background:#25D366;display:grid;place-items:center;box-shadow:0 10px 26px rgba(0,0,0,.4);animation:wap 2.8s ease-in-out infinite;}
.wa-fab svg{width:28px;height:28px;color:#fff;}
@keyframes wap{0%,100%{box-shadow:0 10px 26px rgba(0,0,0,.4),0 0 0 0 rgba(37,211,102,.5)}50%{box-shadow:0 10px 26px rgba(0,0,0,.4),0 0 0 12px rgba(37,211,102,0)}}

/* ── MOBILE DRAWER ── */
.drawer{position:fixed;inset:0;background:rgba(12,9,8,.98);z-index:600;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;opacity:0;pointer-events:none;transition:opacity .3s;}
.drawer.open{opacity:1;pointer-events:all;}
.drawer button{background:none;border:none;color:#fff;font-size:22px;font-weight:800;font-family:Cairo,sans-serif;}
.drawer-close{position:absolute;top:22px;inset-inline-end:22px;background:none;border:none;color:#fff;font-size:26px;line-height:1;}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .items-grid{grid-template-columns:repeat(2,1fr);}
  .rev-grid{grid-template-columns:repeat(2,1fr);}
  .loc-grid{grid-template-columns:1fr;}
}
@media(max-width:640px){
  .desktop-links{display:none;}
  .hmenu-btn{display:block;}
  .items-grid{grid-template-columns:repeat(2,1fr);gap:12px;padding:16px 14px 0;}
  .hero{min-height:85vh;}
  .hero-stats{gap:16px;}
  .rev-grid{grid-template-columns:1fr;}
  .section{padding:52px 0;}
  .cat-bar{top:58px;}
  .btn-wa .wa-txt{display:none;}
}
@media(max-width:380px){.items-grid{grid-template-columns:1fr;}}
</style>
</head>
<body lang-mode="ar">

<!-- NAV -->
<header class="nav">
  <div class="nav-inner">
    <div class="brand" onclick="goTo('home')">
      <img src="data:image/png;base64," alt="99GRILL">
