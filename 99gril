// ─── NAVIGATION ───
function goTo(page){
  activePage = page;
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("act"));
  document.getElementById("page-"+page).classList.add("act");
  document.querySelectorAll(".bnav-btn").forEach(b=>b.classList.remove("act"));
  const bn = document.getElementById("bn-"+page);
  if(bn) bn.classList.add("act");
  document.querySelectorAll(".desktop-links button").forEach(b=>b.classList.remove("act"));
  const nl = document.getElementById("nl-"+page);
  if(nl) nl.classList.add("act");
  window.scrollTo(0,0);
  if(page==="menu"){renderCatBar();renderItems();}
  if(page==="locations") renderLocations();
  if(page==="reviews") renderReviews();
}

function setCat(id){
  activeCat = id;
  renderCatBar();
  renderItems();
  window.scrollTo(0,0);
}

// ─── MODAL ───
let currentCatItems = [];
function openItem(idx){
  const cat = MENU.find(c=>c.id===activeCat);
  const item = cat.items[idx];
  const photo = getPhoto(item.ar);
  const icon = CAT_ICONS[activeCat]||"🍽️";
  const photoSect = photo
    ? `<div class="modal-photo"><img src="${photo}" alt="${item.ar}"></div>`
    : `<div class="modal-ph">${icon}</div>`;
  const desc = lang==="ar" ? item.dAr : item.dEn;
  document.getElementById("modalContent").innerHTML = `
    ${photoSect}
    <div class="modal-body">
      <div class="modal-ar">${item.ar}${item.spicy?' 🌶️':''}</div>
      <div class="modal-en">${item.en}</div>
      ${desc?`<div class="modal-desc">${desc}</div>`:""}
      ${priceHTML(item)}
      <a class="btn-order-modal" href="${waLink()}" target="_blank">
        ${wa_svg()}
        <span>${lang==="ar"?"اطلب الآن عبر واتساب":"Order Now via WhatsApp"}</span>
      </a>
    </div>`;
  document.getElementById("modalWrap").classList.add("open");
  document.body.style.overflow="hidden";
}

function closeModal(){
  document.getElementById("modalWrap").classList.remove("open");
  document.body.style.overflow="";
}

function handleModalClick(e){
  if(e.target===document.getElementById("modalWrap")) closeModal();
}

// ─── DRAWER ───
function openDrawer(){ document.getElementById("drawer").classList.add("open"); }
function closeDrawer(){ document.getElementById("drawer").classList.remove("open"); }

// ─── LANGUAGE ───
function setLang(l){
  lang = l;
  document.body.setAttribute("lang-mode",l);
  document.documentElement.setAttribute("lang",l);
  document.documentElement.setAttribute("dir",l==="ar"?"rtl":"ltr");
  document.getElementById("la").classList.toggle("act",l==="ar");
  document.getElementById("le").classList.toggle("act",l==="en");
  document.querySelectorAll("[data-ar]").forEach(el=>{
    const v = l==="ar"?el.getAttribute("data-ar"):el.getAttribute("data-en");
    if(v!==null) el.innerHTML=v;
  });
  renderTicker();
  renderPicks();
  updateWA();
  if(activePage==="menu"){renderCatBar();renderItems();}
  if(activePage==="locations") renderLocations();
  if(activePage==="reviews") renderReviews();
}

function updateWA(){
  const link = waLink();
  document.getElementById("nav-wa").href=link;
  document.getElementById("hero-wa").href=link;
  document.getElementById("cta-wa").href=link;
  document.getElementById("fab-wa").href=link;
  document.querySelectorAll(".btn-order-modal,.btn-wa-loc").forEach(el=>el.href=link);
