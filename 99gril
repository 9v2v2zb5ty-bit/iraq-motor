// ─── HELPERS ───
const fmt = n => n.toLocaleString("en-US");

function firstPrice(item){
  if(item.type==="simple") return fmt(item.price);
  if(item.rows && item.rows[0]) return fmt(item.rows[0].pp[0]);
  return "";
}

function priceHTML(item){
  if(item.type==="simple"){
    return `<div class="simple-amt">${fmt(item.price)}<span style="font-size:14px;color:rgba(22,16,14,.45);margin-inline-start:4px;">${lang==="ar"?"د.ع":"IQD"}</span></div>`;
  }
  const sizes = item.sL[lang];
  let th = `<tr><th class="rl"></th>${sizes.map(s=>`<th>${s}</th>`).join("")}</tr>`;
  let rows = item.rows.map(r=>`<tr><td class="rl">${r[lang]}</td>${r.pp.map(p=>`<td>${fmt(p)}</td>`).join("")}</tr>`).join("");
  return `<table class="modal-ptable">${th}${rows}</table>`;
}

function wa_svg(){return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>`;}

